{
  "name": "sinsei_umiusi_ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "terminal-gateway",
    "shared/*"
  ],
  "scripts": {
    "build:protocol": "npm run build --workspace @sinsei-umiusi/terminal-protocol",
    "dev": "npm run build:protocol && vite",
    "dev:terminal": "npm run build:protocol && npm run dev --workspace sinsei-umiusi-terminal-gateway",
    "build": "npm run build:protocol && tsc -b && vite build",
    "build:terminal": "npm run build:protocol && npm run build --workspace sinsei-umiusi-terminal-gateway",
    "check:terminal": "npm run build:protocol && npm run check --workspace sinsei-umiusi-terminal-gateway",
    "hash-terminal-password": "npm run build:protocol && npm run hash-password --workspace sinsei-umiusi-terminal-gateway",
    "lint": "biome lint . --write",
    "check:lint": "biome lint .",
    "format": "biome check . --write --formatter-enabled=true --linter-enabled=false",
    "check:format": "biome check . --formatter-enabled=true --linter-enabled=false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sinsei-umiusi/terminal-protocol": "*",
    "@tailwindcss/vite": "^4.1.17",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "roslib": "^2.0.0",
    "tailwindcss": "^4.1.17",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "daisyui": "^5.5.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
