{
  "name": "sinsei-umiusi-terminal-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepare:pty": "node scripts/ensure-node-pty-helper.mjs",
    "dev": "npm run prepare:pty && tsx watch src/server.ts",
    "start": "npm run prepare:pty && node dist/server.js",
    "hash-password": "tsx src/hashPassword.ts"
  },
  "dependencies": {
    "@sinsei-umiusi/terminal-protocol": "*",
    "cookie": "^1.0.2",
    "node-pty": "^1.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
